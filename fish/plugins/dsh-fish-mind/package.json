{
  "name": "dsh-fish-mind",
  "version": "0.7.12",
  "description": "大肥鱼的鱼脑：把每次会话写成经历，并把她的权限关进笼子里。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "fish-mind",
    "long-term-memory",
    "ai-companion",
    "capability-broker"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "MEME-WIKI.md",
    "data"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
